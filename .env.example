# Local secrets for `wrangler dev`. Copy to .env and fill in; .env never goes to git.
# Production keeps them as Worker secrets: `pnpm wrangler secret put <NAME>`,
# or upload this file with `pnpm wrangler deploy --secrets-file .env`.

# Garmin Connect Personal API key. Create it, signed in on the web, at
# https://connect.garmin.com/app/settings/personalApiToken
# It is shown once, expires (30, 90, 180 or 365 days) and only one can be active.
GARMIN_API_KEY=

# Password you type on the consent page when connecting an MCP client.
# Generate one with: openssl rand -base64 32
OWNER_PASSWORD=
